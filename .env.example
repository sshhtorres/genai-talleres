# Copia este archivo como .env y completa las claves. .env NO se versiona.

# ---------------------------------------------------------------------------
# Taller 1 · proveedor por defecto: gemini | anthropic | ollama | fake
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google AI Studio -> https://aistudio.google.com/apikey  (tier gratuito)
GEMINI_API_KEY=

# Anthropic -> https://console.anthropic.com/settings/keys  (de pago)
# Segundo proveedor de la comparación de la Fase 3.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Taller 2 · base vectorial (Postgres + pgvector en Docker: `docker compose up -d`)
# Son credenciales de una base local de desarrollo, no secretos de producción.
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5433
PG_USER=ecomarket
PG_PASSWORD=ecomarket
PG_DB=ecomarket_kb

# ---------------------------------------------------------------------------
# Taller 2 · configuración de ejecución del RAG. Descomenta UNO de los tres bloques.
# ---------------------------------------------------------------------------

# (1) nube: todo con GEMINI_API_KEY. Funciona en cualquier equipo.
RAG_CONFIG=nube

# (2) hibrida: embeddings locales (Ollama + embeddinggemma:300m) y LLM en la nube.
#     Requiere: ollama pull embeddinggemma:300m  + la clave del LLM elegido.
# RAG_CONFIG=hibrida
# RAG_LLM=gemini          # gemini | anthropic (Claude Haiku 5.5, de pago)

# (3) local: todo en Ollama. El modelo de chat depende del nivel de hardware.
#     Requiere: ollama pull embeddinggemma:300m && ollama pull gemma4:e4b
#     `uv run taller02 proveedores --recomendar` sugiere un nivel según tu RAM.
# RAG_CONFIG=local
# LOCAL_TIER=cpu-16gb     # cpu-8gb | cpu-16gb | gpu-12gb | gpu-24gb
